{
  "name": "sail-monitoring-web",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/unit-tests.mjs",
    "test:types": "tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:gates": "node scripts/check-lint-gate.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "node scripts/audit.mjs",
    "artifact:create": "node scripts/artifact.mjs create",
    "artifact:verify": "node scripts/artifact.mjs verify",
    "test:smoke": "npm run artifact:verify && playwright test && npm run artifact:verify",
    "test:integration": "npm run artifact:verify && playwright test --config playwright.integration.config.ts && npm run artifact:verify",
    "prepare:delivery": "node --experimental-transform-types --import ./tests/register.mjs scripts/prepare-delivery.mjs",
    "check": "npm run lint && npm test && npm run test:types && npm run build -- --base-href ./ && npm run artifact:create"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "leaflet": "1.9.4",
    "leaflet-rotatedmarker": "0.2.0",
    "mqtt": "5.15.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "25.9.1",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "10.12.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "@angular/build@21.2.24": {
      "piscina": "5.3.2"
    },
    "make-fetch-happen": {
      "http-cache-semantics": "4.3.0"
    },
    "vite": {
      "esbuild": "0.28.1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
